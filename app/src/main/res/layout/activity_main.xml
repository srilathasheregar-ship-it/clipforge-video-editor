<?xml version="1.0" encoding="utf-8"?>

<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#101010">

    <!-- TOP BAR -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="54dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        android:background="#171717">

        <TextView
            android:id="@+id/titleText"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="ClipForge"
            android:textColor="#FFFFFF"
            android:textSize="20sp"
            android:textStyle="bold"/>

        <TextView
            android:id="@+id/undoButton"
            android:layout_width="45dp"
            android:layout_height="45dp"
            android:gravity="center"
            android:text="↶"
            android:textColor="#FFFFFF"
            android:textSize="28sp"/>

        <TextView
            android:id="@+id/redoButton"
            android:layout_width="45dp"
            android:layout_height="45dp"
            android:gravity="center"
            android:text="↷"
            android:textColor="#FFFFFF"
            android:textSize="28sp"/>

        <Button
            android:id="@+id/exportButton"
            android:layout_width="90dp"
            android:layout_height="42dp"
            android:text="EXPORT"
            android:textSize="11sp"
            android:textColor="#FFFFFF"
            android:backgroundTint="#00A86B"/>

    </LinearLayout>

    <!-- VIDEO PREVIEW -->
    <FrameLayout
        android:id="@+id/previewContainer"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:background="#000000">

        <androidx.media3.ui.PlayerView
            android:id="@+id/playerView"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:keepScreenOn="true"/>

        <!-- TEXT OVERLAY -->
        <TextView
            android:id="@+id/textOverlay"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:text="Your Text"
            android:textColor="#FFFFFF"
            android:textSize="28sp"
            android:textStyle="bold"
            android:padding="8dp"
            android:visibility="gone"
            android:background="#55000000"/>

        <!-- PLAY BUTTON -->
        <TextView
            android:id="@+id/centerPlayButton"
            android:layout_width="65dp"
            android:layout_height="65dp"
            android:layout_gravity="center"
            android:gravity="center"
            android:text="▶"
            android:textColor="#FFFFFF"
            android:textSize="30sp"
            android:background="#66000000"/>

        <!-- FULLSCREEN -->
        <TextView
            android:id="@+id/fullscreenButton"
            android:layout_width="50dp"
            android:layout_height="50dp"
            android:layout_gravity="bottom|end"
            android:gravity="center"
            android:text="⛶"
            android:textColor="#FFFFFF"
            android:textSize="28sp"/>

    </FrameLayout>

    <!-- TIME / SEEK -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="8dp"
        android:paddingEnd="8dp"
        android:background="#0B0B0B">

        <TextView
            android:id="@+id/currentTimeText"
            android:layout_width="55dp"
            android:layout_height="wrap_content"
            android:text="00:00"
            android:textColor="#FFFFFF"
            android:textSize="12sp"/>

        <SeekBar
            android:id="@+id/videoSeekBar"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"/>

        <TextView
            android:id="@+id/durationText"
            android:layout_width="55dp"
            android:layout_height="wrap_content"
            android:gravity="end"
            android:text="00:00"
            android:textColor="#FFFFFF"
            android:textSize="12sp"/>

    </LinearLayout>

    <!-- PLAYBACK CONTROLS -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:orientation="horizontal"
        android:gravity="center"
        android:background="#151515">

        <TextView
            android:id="@+id/previousButton"
            android:layout_width="55dp"
            android:layout_height="match_parent"
            android:gravity="center"
            android:text="|◀"
            android:textColor="#FFFFFF"
            android:textSize="18sp"/>

        <TextView
            android:id="@+id/playPauseButton"
            android:layout_width="65dp"
            android:layout_height="match_parent"
            android:gravity="center"
            android:text="▶"
            android:textColor="#FFFFFF"
            android:textSize="25sp"/>

        <TextView
            android:id="@+id/nextButton"
            android:layout_width="55dp"
            android:layout_height="match_parent"
            android:gravity="center"
            android:text="▶|"
            android:textColor="#FFFFFF"
            android:textSize="18sp"/>

    </LinearLayout>

    <!-- TIMELINE -->
    <HorizontalScrollView
        android:id="@+id/timelineScroll"
        android:layout_width="match_parent"
        android:layout_height="190dp"
        android:fillViewport="false"
        android:background="#0D0D0D"
        android:scrollbars="none">

        <LinearLayout
            android:id="@+id/timelineContainer"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:padding="8dp">

            <!-- VIDEO TRACK -->
            <LinearLayout
                android:id="@+id/videoTrack"
                android:layout_width="650dp"
                android:layout_height="58dp"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:background="#263238">

                <TextView
                    android:layout_width="80dp"
                    android:layout_height="match_parent"
                    android:gravity="center"
                    android:text="VIDEO"
                    android:textColor="#FFFFFF"
                    android:textStyle="bold"
                    android:textSize="11sp"/>

                <TextView
                    android:id="@+id/videoClip"
                    android:layout_width="560dp"
                    android:layout_height="45dp"
                    android:layout_margin="5dp"
                    android:gravity="center"
                    android:text="Video Clip"
                    android:textColor="#FFFFFF"
                    android:background="#37474F"/>

            </LinearLayout>

            <!-- TEXT TRACK -->
            <LinearLayout
                android:id="@+id/textTrack"
                android:layout_width="650dp"
                android:layout_height="45dp"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <TextView
                    android:layout_width="80dp"
                    android:layout_height="match_parent"
                    android:gravity="center"
                    android:text="TEXT"
                    android:textColor="#FFFFFF"
                    android:textSize="10sp"/>

                <TextView
                    android:id="@+id/textClip"
                    android:layout_width="250dp"
                    android:layout_height="35dp"
                    android:gravity="center"
                    android:text="Text Layer"
                    android:textColor="#000000"
                    android:background="#FFC107"/>

            </LinearLayout>

            <!-- STICKER TRACK -->
            <LinearLayout
                android:id="@+id/stickerTrack"
                android:layout_width="650dp"
                android:layout_height="45dp"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <TextView
                    android:layout_width="80dp"
                    android:layout_height="match_parent"
                    android:gravity="center"
                    android:text="STICKER"
                    android:textColor="#FFFFFF"
                    android:textSize="10sp"/>

                <TextView
                    android:id="@+id/stickerClip"
                    android:layout_width="200dp"
                    android:layout_height="35dp"
                    android:gravity="center"
                    android:text="⭐ Sticker"
                    android:textColor="#FFFFFF"
                    android:background="#8E44AD"/>

            </LinearLayout>

            <!-- AUDIO TRACK -->
            <LinearLayout
                android:id="@+id/audioTrack"
                android:layout_width="650dp"
                android:layout_height="45dp"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <TextView
                    android:layout_width="80dp"
                    android:layout_height="match_parent"
                    android:gravity="center"
                    android:text="AUDIO"
                    android:textColor="#FFFFFF"
                    android:textSize="10sp"/>

                <TextView
                    android:id="@+id/audioClip"
                    android:layout_width="400dp"
                    android:layout_height="35dp"
                    android:gravity="center"
                    android:text="♪ Audio Track"
                    android:textColor="#FFFFFF"
                    android:background="#6A1B9A"/>

            </LinearLayout>

        </LinearLayout>

    </HorizontalScrollView>

    <!-- KINEMASTER STYLE TOOLBAR -->
    <HorizontalScrollView
        android:layout_width="match_parent"
        android:layout_height="82dp"
        android:background="#191919"
        android:scrollbars="none">

        <LinearLayout
            android:id="@+id/toolBar"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <Button
                android:id="@+id/mediaButton"
                android:layout_width="85dp"
                android:layout_height="70dp"
                android:text="▣&#10;MEDIA"
                android:textSize="10sp"
                android:textColor="#FFFFFF"
                android:backgroundTint="#202020"/>

            <Button
                android:id="@+id/layerButton"
                android:layout_width="85dp"
                android:layout_height="70dp"
                android:text="＋&#10;LAYER"
                android:textSize="10sp"
                android:textColor="#FFFFFF"
                android:backgroundTint="#202020"/>

            <Button
                android:id="@+id/audioButton"
                android:layout_width="85dp"
                android:layout_height="70dp"
                android:text="♪&#10;AUDIO"
                android:textSize="10sp"
                android:textColor="#FFFFFF"
                android:backgroundTint="#202020"/>

            <Button
                android:id="@+id/textButton"
                android:layout_width="85dp"
                android:layout_height="70dp"
                android:text="T&#10;TEXT"
                android:textSize="10sp"
                android:textColor="#FFFFFF"
                android:backgroundTint="#202020"/>

            <Button
                android:id="@+id/stickerButton"
                android:layout_width="85dp"
                android:layout_height="70dp"
                android:text="★&#10;STICKER"
                android:textSize="10sp"
                android:textColor="#FFFFFF"
                android:backgroundTint="#202020"/>

            <Button
                android:id="@+id/effectButton"
                android:layout_width="85dp"
                android:layout_height="70dp"
                android:text="FX&#10;EFFECT"
                android:textSize="10sp"
                android:textColor="#FFFFFF"
                android:backgroundTint="#202020"/>

            <Button
                android:id="@+id/voiceButton"
                android:layout_width="85dp"
                android:layout_height="70dp"
                android:text="🎙&#10;VOICE"
                android:textSize="10sp"
                android:textColor="#FFFFFF"
                android:backgroundTint="#202020"/>

            <Button
                android:id="@+id/speedButton"
                android:layout_width="85dp"
                android:layout_height="70dp"
                android:text="1×&#10;SPEED"
                android:textSize="10sp"
                android:textColor="#FFFFFF"
                android:backgroundTint="#202020"/>

            <Button
                android:id="@+id/cropButton"
                android:layout_width="85dp"
                android:layout_height="70dp"
                android:text="□&#10;CROP"
                android:textSize="10sp"
                android:textColor="#FFFFFF"
                android:backgroundTint="#202020"/>

            <Button
                android:id="@+id/rotateButton"
                android:layout_width="85dp"
                android:layout_height="70dp"
                android:text="⟳&#10;ROTATE"
                android:textSize="10sp"
                android:textColor="#FFFFFF"
                android:backgroundTint="#202020"/>

            <Button
                android:id="@+id/volumeButton"
                android:layout_width="85dp"
                android:layout_height="70dp"
                android:text="🔊&#10;VOLUME"
                android:textSize="10sp"
                android:textColor="#FFFFFF"
                android:backgroundTint="#202020"/>

        </LinearLayout>

    </HorizontalScrollView>

</LinearLayout>
